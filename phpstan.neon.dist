# Shared starting PHPStan configuration for WordPress code
# (UAMS-Web/uams-claude-skills#10): plugins, must-use plugins, themes. Copy to
# the repository root as `phpstan.neon.dist` and fill in every PLACEHOLDER.
#
# Development dependencies:
#   composer require --dev phpstan/phpstan szepeviktor/phpstan-wordpress "php-stubs/wordpress-stubs:^6.8"
# Pin wordpress-stubs to 6.x (`^6.8`, as uamswp-migration-api does). A bare
# `composer require php-stubs/wordpress-stubs` can resolve 7.1, which breaks
# szepeviktor/phpstan-wordpress. The extension loads the stubs itself; requiring
# the package pins the WordPress version the stubs describe.
# szepeviktor/phpstan-wordpress 2.x requires PHPStan 2.x; a repository on
# PHPStan 1.x upgrades both together.
#
# When the plugin or theme uses WP-CLI (`WP_CLI`, `WP_CLI::add_command()`, and
# friends), also:
#   composer require --dev php-stubs/wp-cli-stubs
# and uncomment the `scanFiles` block below. wp-cli-stubs needs wordpress-stubs
# 6.x as well, so the pin above covers both.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    # PHPStan's opt-in preview channel: turns on rules and stricter analysis
    # that become default in the next major. Ships inside phpstan/phpstan (no
    # extra Composer dependency), but it is not cost-free against WordPress
    # stubs: bleedingEdge can break stub conditional return types (for example
    # `get_sites()`). Keep it while the repository analyzes cleanly; if a stub
    # return type starts failing only with this include, drop the include or
    # pin a narrow `ignoreErrors` entry with a comment naming the stub function
    # (see the code-quality skill).
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    # Optional, when the repository uses Mockery:
    # - vendor/phpstan/phpstan-mockery/extension.neon
    # When the tests run on Pest: Pest's own extension, shipped inside
    # pestphp/pest. It registers Pest's expectation classes as universal object
    # crates, so chained expectations analyze instead of reporting undefined
    # properties. Uncomment together with the Pest entries under ignoreErrors.
    # - vendor/pestphp/pest/extension.neon

parameters:
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-i18n-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php
        - vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php
        - vendor/php-stubs/genesis-stubs/genesis-stubs.php
    # Filled: the PHP versions the code must parse and run on. `min` is the
    # LOWEST version the plugin supports (composer.json's `php` constraint and
    # the plugin header's `Requires PHP`); `max` is the developer's PHP, which
    # the tools run on. Left out, PHPStan infers a version from composer.json
    # and does not report constructs that are unavailable at the floor: in
    # uamswp-migration-api a typed class constant (PHP 8.3+) analyzed clean and
    # would have been a parse error on the PHP 8.2 it ships to. Integers:
    # 7.0 = 70000, 7.4 = 70400, 8.2 = 80200, 8.4 = 80400. The range form needs
    # PHPStan 2.0 or later.
    phpVersion:
        min: 80200
        max: 80400

    # Filled: the highest level the code passes today. Find it by running
    # from 0 upward (see the code-quality skill), then raise it by one per
    # change as findings are fixed, until `max`. Lowering it is a deliberate,
    # argued change, not a quiet edit to get a red run green.
    level: 10

    excludePaths:
        analyseAndScan:
            - tests
            - vendor
            - lib/modules
            - tests

    # Filled: the directories and files holding first-party PHP, including
    # the plugin header file at the root. Include tests: test bugs are real
    # bugs. In a fork of a vendor plugin, only the paths that hold our
    # modifications.
    paths:
        - functions.php
        - home.php
        - page_archive.php
        - page_blog.php
        - search.php
        - acf_fields
        - blocks
        - lib
        - templates

    # Indexed for symbols but not analyzed. `php-stubs/wordpress-stubs` covers
    # core's runtime surface and stops there: `WP_UnitTestCase`, the factories
    # and `tests_add_filter()` ship with WordPress' test suite, not with
    # WordPress. Uncomment when the tests run on wp-phpunit, or the Integration
    # suite analyzes as a pile of undefined classes.
    # scanDirectories:
    #     - vendor/wp-phpunit/wp-phpunit/includes

    # WP-CLI: uncomment after `composer require --dev php-stubs/wp-cli-stubs`.
    # Paths are relative to this neon file (repository root). wordpress-stubs
    # is already loaded by szepeviktor/phpstan-wordpress; list only the WP-CLI
    # stub files here.
    # scanFiles:
    #     - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    #     - vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
    #     - vendor/php-stubs/wp-cli-stubs/wp-cli-i18n-stubs.php
    #     - vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php

    # Constants defined from a function call (`define('MY_PLUGIN_URL',
    # plugin_dir_url(__FILE__))`, `plugin_dir_path()`, and similar) are often
    # invisible to PHPStan: it does not evaluate those calls when discovering
    # constants. Two remedies (pick one per constant):
    #
    # 1. A small bootstrap that `define()`s the same names to plain string (or
    #    path) stand-ins, listed under `bootstrapFiles`. Prefer this when code
    #    concatenates the constant and needs a known string type.
    # 2. List the constant under `dynamicConstantNames` when its value varies by
    #    environment and you only need PHPStan to treat it as defined (and not
    #    fold a specific value).
    #
    # Example (uncomment and rename to the plugin's real constants):
    # bootstrapFiles:
    #     - phpstan-bootstrap.php
    # dynamicConstantNames:
    #     - MY_PLUGIN_URL
    #     - MY_PLUGIN_DIR

    bootstrapFiles:
        - phpstan-bootstrap.php

    # Checkout-scoped cache. PHPStan's default tmpDir is
    # `sys_get_temp_dir()/phpstan`: machine-global, shared by every checkout and
    # worktree on the machine. The cache stores ABSOLUTE phar paths, so deleting
    # the worktree that populated it leaves every stored path dangling, and the
    # next run in a live checkout dies with internal errors of the form
    # `"phar://.../vendor/phpstan/phpstan.phar/..." is not a file`, blaming
    # whichever source file happened to be under analysis. That reads as a real
    # defect in the diff.
    #
    # Neither obvious remedy works: `clear-result-cache` leaves most of the
    # directory in place, and `rm -rf` races any concurrent session analyzing
    # in it. A RELATIVE path resolves against this file's directory, so each
    # checkout gets its own cache and a deleted one takes only its own with it.
    # There is no `--tmp-dir` CLI flag, so this key is the only lever.
    # Add `/.phpstan/` to .gitignore.
    tmpDir: .phpstan

    # WordPress ships a very large global function surface; the stubs cover it,
    # but core's own docblocks are loose enough that a few dynamic returns
    # cannot be narrowed. Add ignores here only with a comment naming the core
    # function responsible, pinned by `identifier` and `path`. Never a blanket
    # pattern. Unmatched entries fail the run (`reportUnmatchedIgnoredErrors`
    # defaults to true), so a stale ignore reds rather than rots.
    #
    # The template ships with no active entry, so a first run at `level: 0` on
    # clean code passes. An entry whose error does not occur fails the run as
    # `ignore.unmatched` unless it says `reportUnmatched: false`, so uncomment
    # each entry below only when its error appears (the Pest entries: when the
    # tests run on Pest). The entries already sit in the list, at the list's
    # indentation, so removing the leading `# ` from an entry's lines is all
    # an entry needs. With every entry commented out the key is empty, which
    # PHPStan reads as no entries.
    ignoreErrors:
        -
            identifier: return.void
            reportUnmatched: false
        # WordPress `remove_action()` reads only its first three arguments; the fourth in
        # functions.php is pinned by a mutation annotation, and removing it changes the call a test asserts.
        -
            identifier: arguments.count
            path: functions.php
            count: 1
        # image_sizer() returns nothing when the input is invalid, though it is
        # declared to return a string. Returning an empty string instead changes what its callers receive.
        -
            identifier: return.empty
            path: functions.php
            count: 1
        # uamswp_nav_subsection() and uamswp_hide_breadcrumbs() return false when
        # nothing applies, though both are declared to return a string. Changing the declared type changes the contract for their callers.
        -
            identifier: return.type
            path: lib/nav.php
            count: 2
        -
            identifier: return.type
            path: lib/page.php
            count: 2
        # The condition follows from `uamswp_nav_subsection()` being declared to return a string while it returns `int|false` (see the `return.type` entry for `lib/nav.php`), so it is evaluated at runtime on the real value.
        -
            identifier: booleanAnd.alwaysFalse
            path: lib/header.php
            count: 1
        # The condition follows from `uamswp_nav_subsection()` being declared to return a string while it returns `int|false` (see the `return.type` entry for `lib/nav.php`), so it is evaluated at runtime on the real value.
        -
            identifier: booleanAnd.leftAlwaysFalse
            path: lib/header.php
            count: 1
        # `is_array()` on the `image_meta` entry is a runtime guard on stored attachment metadata that the WordPress stubs type as an array. Dropping it changes behavior on malformed metadata.
        -
            identifier: booleanAnd.rightAlwaysTrue
            path: lib/media-credit.php
            count: 1
        # The condition follows from `uamswp_nav_subsection()` being declared to return a string while it returns `int|false` (see the `return.type` entry for `lib/nav.php`), so it is evaluated at runtime on the real value.
        -
            identifier: elseif.alwaysFalse
            path: lib/header.php
            count: 1
        # `$excluded_ids` in `uamswp_disable_editor()` is an empty list kept as the place to name excluded page IDs (the commented `page_on_front` line shows the intent), so the `in_array()` check against it is always false until an ID is added.
        -
            identifier: function.impossibleType
            path: lib/misc.php
            count: 1
        # Parameters the function body does not read; many are fixed by the WordPress or ACF callback signature, and the rest are dead. Parameters fixed by a hook signature cannot be removed, and removing a dead one changes the callback arity, tracked in #780.
        -
            identifier: function.unusedParameter
            path: functions.php
            count: 6
        -
            identifier: function.unusedParameter
            path: home.php
            count: 1
        -
            identifier: function.unusedParameter
            path: lib/bootstrap.php
            count: 3
        -
            identifier: function.unusedParameter
            path: lib/comment.php
            count: 1
        -
            identifier: function.unusedParameter
            path: lib/extras.php
            count: 1
        -
            identifier: function.unusedParameter
            path: lib/footer-widgets.php
            count: 2
        -
            identifier: function.unusedParameter
            path: lib/media-credit.php
            count: 1
        -
            identifier: function.unusedParameter
            path: lib/meta-box.php
            count: 1
        -
            identifier: function.unusedParameter
            path: lib/misc.php
            count: 2
        -
            identifier: function.unusedParameter
            path: lib/modules.php
            count: 9
        -
            identifier: function.unusedParameter
            path: lib/nav.php
            count: 2
        -
            identifier: function.unusedParameter
            path: lib/page.php
            count: 2
        -
            identifier: function.unusedParameter
            path: lib/quicklinks.php
            count: 1
        -
            identifier: function.unusedParameter
            path: lib/search.php
            count: 1
        -
            identifier: function.unusedParameter
            path: lib/users.php
            count: 1
        -
            identifier: function.unusedParameter
            path: search.php
            count: 4
        # The `instanceof WP_User` check guards a `wp_get_current_user()` result that the stubs always type as `WP_User`, and a unit test supplies a non-user to pin the guard. Removing it changes that behavior.
        -
            identifier: instanceof.alwaysTrue
            path: lib/users.php
            count: 1
        -
            identifier: ternary.alwaysTrue
            path: search.php
            count: 1
        # An argument whose declared type does not match the parameter, often a value that can be false or null from a WordPress or ACF call. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: argument.type
            path: functions.php
            count: 40
        -
            identifier: argument.type
            path: lib/header.php
            count: 12
        -
            identifier: argument.type
            path: lib/misc.php
            count: 5
        -
            identifier: argument.type
            path: lib/nav.php
            count: 10
        -
            identifier: argument.type
            path: lib/page.php
            count: 22
        -
            identifier: argument.type
            path: lib/users.php
            count: 4
        # An argument whose declared type does not match the parameter, often a value that can be false or null from a WordPress or ACF call. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: argument.type
            path: home.php
            count: 1
        -
            identifier: argument.type
            path: lib/breadcrumb.php
            count: 2
        -
            identifier: argument.type
            path: lib/extras.php
            count: 9
        -
            identifier: argument.type
            path: lib/media-credit.php
            count: 19
        -
            identifier: argument.type
            path: lib/scripts.php
            count: 4
        # Arithmetic on a value PHPStan cannot prove is a number. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: binaryOp.invalid
            path: lib/breadcrumb.php
            count: 2
        # A foreach over a value that WordPress or ACF may return as false. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: foreach.nonIterable
            path: functions.php
            count: 3
        -
            identifier: foreach.nonIterable
            path: lib/nav.php
            count: 2
        # Array access on a value that WordPress or ACF may return as false or null. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: offsetAccess.nonOffsetAccessible
            path: functions.php
            count: 28
        -
            identifier: offsetAccess.nonOffsetAccessible
            path: lib/media-credit.php
            count: 10
        -
            identifier: offsetAccess.nonOffsetAccessible
            path: lib/misc.php
            count: 4
        # Property access on a value that WordPress may return as false or null. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: property.nonObject
            path: functions.php
            count: 10
        -
            identifier: property.nonObject
            path: lib/extras.php
            count: 2
        -
            identifier: property.nonObject
            path: lib/quicklinks.php
            count: 16
        # A property that the declared type does not list. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: property.notFound
            path: search.php
            count: 1
        # An argument whose declared type does not match the parameter, often a value that can be false or null from a WordPress or ACF call. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: argument.type
            path: lib/a11y.php
            count: 3
        # A method call on a value that WordPress may return as false or null. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: method.nonObject
            path: lib/users.php
            count: 12
        # Property access on a `$post` value that WordPress may return as false or null. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: property.nonObject
            path: lib/misc.php
            count: 3
        # A return value whose type does not match the declared return type. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: return.type
            path: lib/a11y.php
            count: 1
        # An argument whose declared type does not match the parameter, usually mixed, false or null from a WordPress or ACF call. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        # `gallery_image_dimension()` documents `$ratio` as `int`, and the crop select passes a decimal string such as '1.7778' or -1, so the seven calls read as mismatched. Correcting the docblock belongs to `functions.php`, outside this slice, tracked in #780.
        -
            identifier: argument.type
            path: blocks/gallery.php
            count: 7
        -
            identifier: argument.type
            path: blocks/image-side-by-side.php
            count: 50
        -
            identifier: argument.type
            path: lib/blocks.php
            count: 3
        -
            identifier: argument.type
            path: lib/bootstrap.php
            count: 2
        -
            identifier: argument.type
            path: search.php
            count: 21
        # Concatenation or arithmetic on a `mixed` value from `get_field()` or an option that PHPStan cannot prove is a string or number. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: binaryOp.invalid
            path: functions.php
            count: 9
        -
            identifier: binaryOp.invalid
            path: lib/extras.php
            count: 22
        # An integer cast of a value PHPStan cannot prove is numeric, such as mixed from get_field(). Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: cast.int
            path: functions.php
            count: 2
        # A foreach over decoded JSON of unknown shape. Narrowing it needs a runtime check that changes behavior on unexpected data.
        -
            identifier: foreach.nonIterable
            path: lib/quicklinks.php
            count: 1
        # Array access on a `mixed` block field from ACF. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: offsetAccess.nonOffsetAccessible
            path: blocks/image-side-by-side.php
            count: 11
        -
            identifier: offsetAccess.nonOffsetAccessible
            path: lib/footer-widgets.php
            count: 1
        -
            identifier: offsetAccess.nonOffsetAccessible
            path: lib/nav.php
            count: 7
        # image_sizer() returns a value PHPStan types as `mixed` from a WordPress or plugin call. Proving it a string needs a runtime check that changes behavior.
        -
            identifier: return.type
            path: functions.php
            count: 1
        # `image_sizer()` and `wp_get_attachment_url()` take the ACF image value, an attachment ID or an array depending on the field's return format (this field sets none, so ACF's default applies). Casting it would change what those functions receive, tracked in #780.
        -
            identifier: argument.type
            path: blocks/call-out.php
            count: 8
        -
            identifier: argument.type
            path: blocks/cta.php
            count: 8
        -
            identifier: argument.type
            path: blocks/hero.php
            count: 29
        -
            identifier: argument.type
            path: blocks/overlay.php
            count: 30
        -
            identifier: argument.type
            path: lib/footer.php
            count: 11
        -
            identifier: argument.type
            path: lib/geo.php
            count: 10
        -
            identifier: argument.type
            path: lib/modules.php
            count: 10
        -
            identifier: argument.type
            path: lib/quicklinks.php
            count: 4
        -
            identifier: argument.type
            path: lib/widgets.php
            count: 4
        # A compound assignment on a value PHPStan types as mixed. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: assignOp.invalid
            path: functions.php
            count: 1
        -
            identifier: assignOp.invalid
            path: lib/bootstrap.php
            count: 1
        -
            identifier: assignOp.invalid
            path: lib/nav.php
            count: 2
        -
            identifier: assignOp.invalid
            path: lib/page.php
            count: 5
        -
            identifier: assignOp.invalid
            path: templates/page_landing.php
            count: 1
        # Arithmetic or concatenation on a value PHPStan types as mixed. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: binaryOp.invalid
            path: blocks/hero.php
            count: 3
        -
            identifier: binaryOp.invalid
            path: blocks/image-side-by-side.php
            count: 3
        -
            identifier: binaryOp.invalid
            path: blocks/overlay.php
            count: 3
        -
            identifier: binaryOp.invalid
            path: home.php
            count: 1
        -
            identifier: binaryOp.invalid
            path: lib/a11y.php
            count: 1
        -
            identifier: binaryOp.invalid
            path: lib/bootstrap.php
            count: 2
        -
            identifier: binaryOp.invalid
            path: lib/footer.php
            count: 5
        -
            identifier: binaryOp.invalid
            path: lib/header.php
            count: 5
        -
            identifier: binaryOp.invalid
            path: lib/misc.php
            count: 3
        -
            identifier: binaryOp.invalid
            path: lib/modules.php
            count: 6
        -
            identifier: binaryOp.invalid
            path: lib/nav.php
            count: 2
        -
            identifier: binaryOp.invalid
            path: lib/quicklinks.php
            count: 4
        -
            identifier: binaryOp.invalid
            path: lib/widgets.php
            count: 2
        -
            identifier: binaryOp.invalid
            path: search.php
            count: 5
        # A string cast of a value PHPStan types as mixed. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: cast.string
            path: lib/bootstrap.php
            count: 1
        # Output of a value PHPStan types as mixed, such as the result of get_field(). Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: echo.nonString
            path: blocks/overlay.php
            count: 1
        -
            identifier: echo.nonString
            path: functions.php
            count: 1
        -
            identifier: echo.nonString
            path: lib/modules.php
            count: 2
        -
            identifier: echo.nonString
            path: lib/page.php
            count: 3
        -
            identifier: echo.nonString
            path: lib/widgets.php
            count: 4
        # A mixed value interpolated into a string. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
            identifier: encapsedStringPart.nonString
            path: functions.php
            count: 3
        # A foreach over a value PHPStan types as mixed. Narrowing it needs a runtime check that changes behavior on unexpected data, tracked in #780.
        -
