            count: 1
        -
            identifier: missingType.return
            path: lib/misc.php
            count: 4
        -
            identifier: missingType.return
            path: lib/modules.php
            count: 8
        -
            identifier: missingType.return
            path: lib/nav.php
            count: 4
        -
            identifier: missingType.return
            path: lib/page.php
            count: 4
        -
            identifier: missingType.return
