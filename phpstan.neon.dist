            path: lib/meta-box.php
            count: 1
        -
            identifier: missingType.parameter
            path: lib/misc.php
            count: 6
        -
            identifier: missingType.parameter
            path: lib/modules.php
            count: 18
        -
            identifier: missingType.parameter
            path: lib/nav.php
            count: 7
        -
            identifier: missingType.parameter
            path: lib/page.php
            count: 5
        -
            identifier: missingType.parameter
            path: lib/pagination.php
            count: 3
        -
            identifier: missingType.parameter
            path: lib/quicklinks.php
            count: 1
        -
            identifier: missingType.parameter
            path: lib/scripts.php
            count: 1
        -
            identifier: missingType.parameter
            path: lib/search.php
            count: 1
        -
            identifier: missingType.parameter
            path: lib/tgm.php
            count: 1
        -
