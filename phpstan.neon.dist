            path: templates/page_landing.php
            count: 1
        # Functions declared without a return type; adding one changes the contract with WordPress and ACF callers, so it is left to a later change (see #745).
        -
            identifier: missingType.return
            path: functions.php
            count: 12
        -
            identifier: missingType.return
            path: lib/blocks.php
            count: 1
        -
            identifier: missingType.return
            path: lib/bootstrap.php
            count: 6
        -
