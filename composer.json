{
    "name": "uams-web/uams-2020",
    "description": "Development tooling for UAMS 2020",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "cweagans/composer-patches": "^2.0",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/wordpress-stubs": "6.8",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "uams-web/patches-pest-plugin-mutate": "^1.2"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "cweagans/composer-patches": true
        }
    },
    "scripts": {
        "setup:integration": "@composer install --working-dir=tests/Integration",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "pest",
        "test:integration": "@php tests/Integration/vendor/bin/phpunit --configuration tests/Integration/phpunit.xml",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "refactor": "rector",
        "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
        "test:refactor": "rector --dry-run",
        "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php",
        "mutate": "php tests/mutate.php",
        "pint": "pint",
        "test:pint": "pint --test"
    },
    "scripts-descriptions": {
        "setup:integration": "Install the Integration suite's own Composer setup (PHPUnit 9.6, wp-phpunit, the polyfills).",
        "test": "Run both suites, each in its own process, so the Unit suite never sees WordPress.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database.",
        "mutate": "Run the mutation check over every covered file: the root templates, functions.php and search.php, lib, acf_fields and blocks. Needs PCOV or Xdebug; pass --path=<files> to narrow it.",
        "test:integration": "Run the PHPUnit 9.6 suite that boots WordPress through wp-phpunit against the test database."
    },
    "autoload-dev": {
        "psr-4": {
            "Uams2020\\Tests\\": "tests/"
        }
    },
    "repositories": [{
        "name": "patches-pest-plugin-mutate",
        "type": "vcs",
        "url": "https://github.com/UAMS-Web/patches-pest-plugin-mutate.git"
    }]
}
